{
  "name": "int-lll-backend",
  "version": "1.0.0",
  "description": "整数格 LLL 约简与 Babai 近似最近点教学后端（TypeScript + Node.js + SQLite）",
  "type": "commonjs",
  "main": "dist/src/cli.js",
  "bin": {
    "lll": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/cli.js serve",
    "demo": "npm run build && node dist/src/demo.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

